package [[ .Package ]]

import (
	"context"
	"errors"
	"log/slog"
	"net/http"

	"github.com/google/uuid"

	"[[ .Module ]]/internal/platform/httpx"
)

// Handler serves the [[ .Name ]] HTTP endpoints.
type Handler struct {
	svc    *Service
	logger *slog.Logger
}

// NewHandler constructs a Handler.
func NewHandler(svc *Service, logger *slog.Logger) *Handler {
	return &Handler{svc: svc, logger: logger}
}

// Routes registers the [[ .Name ]] endpoints on api.
func (h *Handler) Routes(api httpx.API, requireAuth func(http.Handler) http.Handler) {
	httpx.Register(api, httpx.Operation{
		OperationID: "get[[ .Singular ]]",
		Method:      http.MethodGet,
		Path:        "/v1/[[ .Name ]]/{id}",
		Summary:     "Get [[ .Singular ]] by ID",
		Tags:        []string{"[[ .Name ]]"},
		Security:    []map[string][]string{{"bearerAuth": {}}},
		Middlewares: httpx.Middlewares{httpx.AdaptMiddleware(requireAuth)},
	}, h.get)
}

type get[[ .Singular ]]Input struct {
	ID string `path:"id" doc:"[[ .Singular ]] ID" format:"uuid"`
}

type [[ .Singular ]]Output struct {
	Body [[ .Singular ]]
}

func (h *Handler) get(ctx context.Context, input *get[[ .Singular ]]Input) (*[[ .Singular ]]Output, error) {
	id, err := uuid.Parse(input.ID)
	if err != nil {
		return nil, httpx.NewProblem(http.StatusBadRequest, "invalid id")
	}
	item, err := h.svc.Get(ctx, id)
	if errors.Is(err, ErrNotFound) {
		return nil, httpx.NewProblem(http.StatusNotFound, "not found")
	}
	if err != nil {
		h.logger.ErrorContext(ctx, "get [[ .Singular ]] failed", "error", err, "request_id", httpx.RequestIDFrom(ctx))
		return nil, httpx.NewProblem(http.StatusInternalServerError, "")
	}
	return &[[ .Singular ]]Output{Body: item}, nil
}
