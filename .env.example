# Copy to .env for local development. Every value below is safe for local use only.

ENV=local
SERVICE_NAME={{APP_NAME}}
ADDR=:8080
LOG_LEVEL=info

# Pooled URL used by the API and worker. DIRECT_DATABASE_URL is used for migrations
# and LISTEN/NOTIFY; leave it empty to fall back to DATABASE_URL.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DIRECT_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Comma-separated CIDRs of proxies allowed to set X-Forwarded-For / CF-Connecting-IP.
# Empty trusts none.
TRUSTED_PROXIES=

# 64 hex characters (32 bytes). Generate one with: openssl rand -hex 32
AUTH_TOKEN_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_THREADS=2

RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_PER_MIN=5

# template:example:begin acme
WEBHOOK_ACME_SECRET=local-only-webhook-secret
# template:example:end acme

# OTLP/HTTP collector URL, for example http://localhost:4318. Empty disables tracing export.
OTEL_EXPORTER_OTLP_ENDPOINT=

WORKER_CONCURRENCY=10

# Read by cmd/seed only (Phase 4.b).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-1234
